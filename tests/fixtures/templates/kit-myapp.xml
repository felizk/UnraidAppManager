<?xml version="1.0"?>
<Container version="2">
  <Name>myapp</Name>
  <Repository>ghcr.io/OWNER/myapp:latest</Repository>
  <Registry>https://github.com/OWNER/myapp/pkgs/container/myapp</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Shell>sh</Shell>
  <Support>https://github.com/OWNER/myapp/issues</Support>
  <Project>https://github.com/OWNER/myapp</Project>
  <Overview>One or two sentences about what myapp does.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/OWNER/myapp/main/unraid/icon.png</Icon>
  <ExtraParams></ExtraParams>
  <PostArgs></PostArgs>
  <Config Name="Web UI" Target="8080" Default="8080" Mode="tcp" Description="HTTP port (UAM may remap it)" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/myapp" Mode="rw" Description="Persistent data" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/myapp</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Copenhagen" Mode="" Description="Time zone" Type="Variable" Display="always" Required="false" Mask="false">Europe/Copenhagen</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User id" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group id" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="API token" Target="MYAPP_API_TOKEN" Default="" Mode="" Description="Secret; leave empty to disable" Type="Variable" Display="always" Required="false" Mask="true"></Config>
</Container>
